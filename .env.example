# Copy to .env (repo root, read by docker compose) or api/.env (local dev).
# All of these are optional. Without an LLM the assistant runs in offline mode.

# --- Free LLM options (any OpenAI-compatible endpoint with tool calling) ---
# Groq free tier:        https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Google Gemini free tier (https://aistudio.google.com/apikey):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# Ollama, fully local and free (ollama pull qwen2.5:7b):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b

# --- Local dev without Docker ---
# DATABASE_URL=sqlite:///./rafta.db
# SEED_ON_STARTUP=true
